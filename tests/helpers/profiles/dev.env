# Test profile: local development, mkcert self-signed certs, mailhog.
# Mirrors setup.env.example -- keep the key set in sync with it.
HABIDAT_TITLE="habi*DAT"
HABIDAT_DESCRIPTION="habi*DAT test platform"
HABIDAT_ADMIN_EMAIL=admin@example.com
HABIDAT_ADMIN_PASSWORD=generate
HABIDAT_DOMAIN=habidat.localhost
HABIDAT_DOCKER_PREFIX=habidattest
HABIDAT_BACKUP_DIR=/tmp/habidat-test-backup

HABIDAT_LDAP_DOMAIN=habidat.localhost
HABIDAT_LDAP_BASE=dc=habidat,dc=localhost

HABIDAT_MAILHOG=true
HABIDAT_SMTP_EMAILFROM=admin@habidat.localhost
HABIDAT_SMTP_HOST=mailhog
HABIDAT_SMTP_PORT=1025
HABIDAT_SMTP_USER=
HABIDAT_SMTP_PASSWORD=
HABIDAT_SMTP_TLS=false
HABIDAT_SMTP_AUTHMETHOD=none

HABIDAT_EXPOSE_LDAP=false
HABIDAT_CREATE_SELFSIGNED=true
HABIDAT_LETSENCRYPT=false
HABIDAT_PROTOCOL=https
HABIDAT_EXISTING_NGINX_GENERATOR_NETWORK=
HABIDAT_EXISTING_BACKEND_NETWORK=

HABIDAT_LOGO=habidat.png

HABIDAT_USER_SUBDOMAIN=user
HABIDAT_NEXTCLOUD_SUBDOMAIN=cloud
HABIDAT_NEXTCLOUD_DEFAULTQUOTA="1 GB"
# Database tuning. Overridden here so the render tests cover the override path;
# the other profiles leave them empty to cover the built-in defaults.
HABIDAT_NEXTCLOUD_DB_BUFFER_POOL_SIZE=512M
HABIDAT_NEXTCLOUD_DB_MAX_CONNECTIONS=100
HABIDAT_NEXTCLOUD_DB_IO_CAPACITY=2000
HABIDAT_NEXTCLOUD_DB_IO_CAPACITY_MAX=4000
HABIDAT_NEXTCLOUD_DB_TMP_TABLE_SIZE=64M
HABIDAT_DISCOURSE_SUBDOMAIN=discourse
HABIDAT_DIREKTKREDIT_SUBDOMAIN=direktkredit
HABIDAT_MEDIAWIKI_SUBDOMAIN=mediawiki
HABIDAT_DOKUWIKI_SUBDOMAIN=dokuwiki
HABIDAT_MAILTRAIN_PUBLIC_SUBDOMAIN=lists
HABIDAT_MAILTRAIN_SUBDOMAIN=mailtrain
HABIDAT_MAILTRAIN_SANDBOX_SUBDOMAIN=sandbox.mailtrain

COMPOSE_HTTP_TIMEOUT=200
