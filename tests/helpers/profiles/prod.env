# Test profile: production, Let's Encrypt, real SMTP, LDAP port exposed.
# Mirrors setup.env.example -- keep the key set in sync with it.
HABIDAT_TITLE="habi*DAT"
HABIDAT_DESCRIPTION="habi*DAT test platform"
HABIDAT_ADMIN_EMAIL=admin@example.com
HABIDAT_ADMIN_PASSWORD=generate
HABIDAT_DOMAIN=example.org
HABIDAT_DOCKER_PREFIX=habidattest
HABIDAT_BACKUP_DIR=/tmp/habidat-test-backup

HABIDAT_LDAP_DOMAIN=example.org
HABIDAT_LDAP_BASE=dc=example,dc=org

HABIDAT_MAILHOG=false
HABIDAT_SMTP_EMAILFROM=noreply@example.org
HABIDAT_SMTP_HOST=smtp.example.org
HABIDAT_SMTP_PORT=587
HABIDAT_SMTP_USER=postmaster@example.org
HABIDAT_SMTP_PASSWORD=s3cr3t
HABIDAT_SMTP_TLS=true
HABIDAT_SMTP_AUTHMETHOD=login

HABIDAT_EXPOSE_LDAP=true
HABIDAT_CREATE_SELFSIGNED=false
HABIDAT_LETSENCRYPT=true
HABIDAT_PROTOCOL=https
HABIDAT_EXISTING_NGINX_GENERATOR_NETWORK=
HABIDAT_EXISTING_BACKEND_NETWORK=

HABIDAT_LOGO=habidat.png

HABIDAT_USER_SUBDOMAIN=user
HABIDAT_NEXTCLOUD_SUBDOMAIN=cloud
HABIDAT_NEXTCLOUD_DEFAULTQUOTA="1 GB"
HABIDAT_DISCOURSE_SUBDOMAIN=discourse
HABIDAT_DIREKTKREDIT_SUBDOMAIN=direktkredit
HABIDAT_MEDIAWIKI_SUBDOMAIN=mediawiki
HABIDAT_DOKUWIKI_SUBDOMAIN=dokuwiki
HABIDAT_MAILTRAIN_PUBLIC_SUBDOMAIN=lists
HABIDAT_MAILTRAIN_SUBDOMAIN=mailtrain
HABIDAT_MAILTRAIN_SANDBOX_SUBDOMAIN=sandbox.mailtrain

COMPOSE_HTTP_TIMEOUT=200
