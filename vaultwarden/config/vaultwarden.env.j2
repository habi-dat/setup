DOMAIN={{ HABIDAT_PROTOCOL | default('https') }}://{{ HABIDAT_VAULTWARDEN_SUBDOMAIN }}.{{ HABIDAT_DOMAIN }}
VIRTUAL_HOST={{ HABIDAT_VAULTWARDEN_SUBDOMAIN }}.{{ HABIDAT_DOMAIN }}
VIRTUAL_PORT=80
LETSENCRYPT_HOST={{ HABIDAT_VAULTWARDEN_SUBDOMAIN }}.{{ HABIDAT_DOMAIN }}
LETSENCRYPT_EMAIL={{ HABIDAT_ADMIN_EMAIL }}

# Login only through habidat-auth (OIDC). Users still set a master password,
# which never leaves their device.
SSO_ENABLED=true
SSO_ONLY=true
SSO_AUTHORITY={{ HABIDAT_PROTOCOL | default('https') }}://{{ HABIDAT_USER_SUBDOMAIN }}.{{ HABIDAT_DOMAIN }}/oidc
SSO_CLIENT_ID=vaultwarden
SSO_CLIENT_SECRET={{ HABIDAT_VAULTWARDEN_OIDC_CLIENT_SECRET }}
SSO_SCOPES=email profile
SSO_SIGNUPS_MATCH_EMAIL=true
# habidat-auth issues no refresh tokens, so Vaultwarden keeps its own session.
SSO_AUTH_ONLY_NOT_SESSION=true
SIGNUPS_ALLOWED=false

# One organization (owned by the super admin), shared with auth groups
# through collections. See docs/adr/0002 and 0004.
ORG_GROUPS_ENABLED=true
ORG_CREATION_USERS={{ HABIDAT_VAULTWARDEN_ADMIN_EMAIL }}

# No SMTP on purpose: only then are organization invitations accepted
# automatically when a user sets their master password. See docs/adr/0003.
PUSH_ENABLED=false

ADMIN_TOKEN={{ HABIDAT_VAULTWARDEN_ADMIN_TOKEN }}
