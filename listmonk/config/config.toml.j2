[app]
address = "0.0.0.0:9000"

[db]
# Container name, not the service name: every listmonk instance (and other
# modules) has a "db" service on the shared backend network, so "db" is ambiguous.
host = "{{ HABIDAT_DOCKER_PREFIX }}-listmonk-{{ HABIDAT_LISTMONK_PROJECTID }}-db"
port = 5432
user = "listmonk"
password = "{{ HABIDAT_LISTMONK_DB_PASSWORD }}"
database = "listmonk"
ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"
